<!doctype html>
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description | escape }}">
    <title>{{ title | escape }}</title>
    <link rel="icon" href="/assets/app-icon.png">
    <link rel="stylesheet" href="/assets/vendor/simple.min.css">
    <link rel="stylesheet" href="/assets/site.css">
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="{{ languageNavigationLabel }}">
        <ul>
          <li>
            <a href="/" lang="en" hreflang="en"{% if lang == "en" %} aria-current="page"{% endif %}>English</a>
          </li>
          <li>
            <a href="/ja/" lang="ja" hreflang="ja"{% if lang == "ja" %} aria-current="page"{% endif %}>日本語</a>
          </li>
        </ul>
      </nav>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer>
      <p>
        <a href="https://github.com/jsoizo/mutelet">GitHub</a>
        · <a href="https://github.com/jsoizo/mutelet/blob/main/docs/PRIVACY.md">{{ privacyLabel }}</a>
        · <a href="https://github.com/jsoizo/mutelet/blob/main/LICENSE">MIT License</a>
      </p>
    </footer>
  </body>
</html>
